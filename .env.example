# MongoDB connection used to load the process list.
# Copy this file to ".env" and fill in real values.
MONGODB_HOST=146.190.194.104
MONGODB_PORT=27017
MONGODB_USER=goprocessUser1
MONGODB_PASSWORD=your-password-here
MONGODB_DB=goprocess_uat
# DB where the user was created (defaults to MONGODB_DB if omitted)
MONGODB_AUTHSOURCE=goprocess_uat
# Collection that holds the process documents
MONGODB_COLLECTION=processes
